# AI Recovery CRM API — environment template.
# Copy to .env and fill in real values. Never commit .env.

# --- Application ---
PROJECT_NAME="AI Recovery CRM API"
VERSION="1.0.0"
# development | test | production
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# --- Security ---
# REQUIRED in production: at least 32 characters, unique per deployment.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database (PostgreSQL) ---
# Local development against the compose stack:
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/recovery_crm"
# Fail fast when the database host is unreachable (seconds).
DB_CONNECT_TIMEOUT_SECONDS=3

# --- Valkey / cache ---
# Optional in Phase 1: nothing in the request path uses the cache.
VALKEY_URL="redis://localhost:6379/0"
# Set to true only once a cached code path actually exists.
CACHE_REQUIRED_FOR_READINESS=false

# --- Uploads ---
MAX_UPLOAD_SIZE_BYTES=26214400
MAX_IMPORT_ROWS=50000

# --- CORS ---
# Comma-separated list or a JSON array. Never use "*" in production.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Rate limiting (per worker process, disabled automatically in tests) ---
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
